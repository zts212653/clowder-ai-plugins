{
  "ns": "github",
  "icon": "mark",
  "icons": {
    "mark": "<path d=\"M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21\"/>"
  },
  "inserts": [
    {
      "id": "github.community",
      "anchor": "panel.tools",
      "at": "inside",
      "node": {
        "title": "t:github.plugin.entries.community",
        "icon": "msg",
        "open": {
          "node": "github.community"
        },
        "tool": true
      }
    }
  ],
  "templates": [
    {
      "slot": "chat.tool.result",
      "id": "prcard",
      "match": {
        "tool": "gh pr view"
      },
      "priority": 10,
      "icon": "mark",
      "by": "GitHub 插件",
      "extract": {
        "pr": {
          "from": "tool",
          "re": "pr view (\\d+)"
        },
        "state": {
          "from": "json",
          "key": "state"
        },
        "draft": {
          "from": "json",
          "key": "isDraft",
          "map": {
            "true": "Draft",
            "false": ""
          }
        },
        "merge": {
          "from": "json",
          "key": "mergeCommit",
          "empty": "未合入"
        }
      },
      "title": "PR #{pr}",
      "chips": [
        "{state}",
        "{draft}"
      ],
      "line": "mergeCommit：{merge}"
    },
    {
      "slot": "chat.rich",
      "id": "issueDraft",
      "keys": [
        "card.community_issue_draft",
        "card.community_issue_preview"
      ],
      "node": {
        "blocks": [
          {
            "type": "box",
            "variant": "card",
            "blocks": [
              {
                "type": "text",
                "variant": "title",
                "text": "$.card.title"
              },
              {
                "type": "settings",
                "when": [
                  "$.card.canEdit",
                  "!$.pending"
                ],
                "rows": [
                  {
                    "label": "t:github.chatCards.field.repo",
                    "when": "!$.card.draftId",
                    "ctls": [
                      {
                        "type": "select",
                        "id": "$.card.repoId",
                        "value": "$.card.targetRepo",
                        "options": [
                          {
                            "from": "$.card.repos",
                            "item": {
                              "v": "@",
                              "label": "@"
                            }
                          }
                        ],
                        "label": "t:github.chatCards.field.repo",
                        "change": "plugin",
                        "args": {
                          "request": "edit",
                          "mid": "$.card.mid",
                          "b": "$.card.sourceId",
                          "field": "targetRepo"
                        }
                      }
                    ]
                  },
                  {
                    "label": "t:github.issueDraft.title",
                    "ctls": [
                      {
                        "type": "input",
                        "id": "$.card.titleId",
                        "value": "$.card.titleValue",
                        "label": "t:github.issueDraft.title",
                        "change": "plugin",
                        "args": {
                          "request": "edit",
                          "mid": "$.card.mid",
                          "b": "$.card.sourceId",
                          "field": "title"
                        }
                      }
                    ]
                  },
                  {
                    "label": "t:github.issueDraft.body",
                    "ctls": [
                      {
                        "type": "input",
                        "id": "$.card.bodyId",
                        "value": "$.card.bodyMarkdown",
                        "rows": 8,
                        "label": "t:github.issueDraft.body",
                        "change": "plugin",
                        "args": {
                          "request": "edit",
                          "mid": "$.card.mid",
                          "b": "$.card.sourceId",
                          "field": "bodyMarkdown"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "kv",
                "from": [
                  {
                    "k": "draftId",
                    "v": "$.card.draftId"
                  },
                  {
                    "k": "t:github.chatCards.field.repo",
                    "v": "$.card.targetRepo"
                  }
                ],
                "when": "$.card.draftId"
              },
              {
                "type": "status",
                "text": {
                  "of": "$.pending",
                  "map": {
                    "true": "t:common.loading",
                    "false": {
                      "of": "$.card.state",
                      "map": {
                        "loading": "t:common.loading",
                        "published": "t:github.issueDraft.published",
                        "cancelled": "t:common.status.cancelled",
                        "draft": "t:common.status.draft",
                        "_": ""
                      }
                    }
                  }
                },
                "when": {
                  "of": "$.pending",
                  "map": {
                    "true": true,
                    "false": "$.card.state"
                  }
                }
              },
              {
                "type": "notice",
                "tone": "warn",
                "text": "$.card.lastError",
                "when": "$.card.lastError",
                "action": {
                  "type": "button",
                  "label": "t:common.retry",
                  "act": "plugin",
                  "args": {
                    "request": "retry",
                    "mid": "$.card.mid",
                    "b": "$.card.sourceId"
                  },
                  "disabled": "$.pending"
                }
              },
              {
                "type": "toolbar",
                "items": [
                  {
                    "type": "button",
                    "label": "t:common.open",
                    "act": "openUrl",
                    "args": {
                      "url": "$.card.url"
                    },
                    "when": "$.card.url",
                    "disabled": "$.pending"
                  },
                  {
                    "type": "grow"
                  },
                  {
                    "type": "button",
                    "label": "t:common.cancel",
                    "act": "plugin",
                    "args": {
                      "request": "cancel",
                      "mid": "$.card.mid",
                      "b": "$.card.sourceId"
                    },
                    "when": "$.card.canCancel",
                    "disabled": "$.pending"
                  },
                  {
                    "type": "button",
                    "primary": true,
                    "label": "t:github.issueDraft.create",
                    "act": "plugin",
                    "args": {
                      "request": "create",
                      "mid": "$.card.mid",
                      "b": "$.card.sourceId"
                    },
                    "when": "$.card.canCreate",
                    "disabled": "$.pending"
                  },
                  {
                    "type": "button",
                    "primary": true,
                    "label": "t:github.issueDraft.publish",
                    "act": "plugin",
                    "args": {
                      "request": "publish",
                      "mid": "$.card.mid",
                      "b": "$.card.sourceId"
                    },
                    "when": "$.card.canPublish",
                    "disabled": "$.pending"
                  }
                ]
              }
            ],
            "load": "$.load"
          }
        ],
        "sources": {
          "card": "draft"
        }
      }
    }
  ],
  "views": {
    "github.community": {
      "loading": "t:github.wsCommunity.load.loading",
      "error": "t:github.wsCommunity.load.error",
      "empty": "t:github.wsCommunity.load.text",
      "blocks": [
        {
          "type": "head",
          "variant": "detail",
          "when": "$.community.detail.gone",
          "title": "t:github.wsCommunity.detail.title"
        },
        {
          "type": "head",
          "variant": "detail",
          "when": "$.community.detail.n",
          "eyebrow": [
            {
              "parts": [
                {
                  "parts": [
                    "#",
                    "$.community.detail.n"
                  ],
                  "sep": ""
                }
              ],
              "mono": true
            },
            {
              "parts": [
                {
                  "parts": [
                    " · ",
                    {
                      "of": "$.community.detail.state",
                      "map": {
                        "pending_decision": "t:github.wsCommunity.pendingDecision",
                        "unreplied": "t:github.wsCommunity.unreplied",
                        "discussing": "t:github.wsCommunity.discussing",
                        "accepted": "t:github.memoryOwners.stateNote.materialized",
                        "rejected": "t:github.memoryOwners.stateNote.rejected",
                        "closed": "t:github.wsCommunity.closed",
                        "_": "$.community.detail.state"
                      }
                    },
                    " · ",
                    {
                      "of": "$.community.detail.ago",
                      "fmt": "ago"
                    }
                  ],
                  "sep": ""
                }
              ]
            }
          ],
          "title": "$.community.detail.title",
          "sub": {
            "parts": [
              {
                "of": "$.community.detail.hasCat",
                "map": {
                  "true": {
                    "parts": [
                      {
                        "of": [
                          0,
                          1,
                          2
                        ],
                        "item": {
                          "of": "@",
                          "map": {
                            "0": "$.community.detail.catName",
                            "1": " ",
                            "2": "$.community.detail.catHandle"
                          }
                        },
                        "sep": ""
                      },
                      " → ",
                      "$.community.detail.threadTitle"
                    ],
                    "sep": ""
                  },
                  "false": "—",
                  "_": "$.community.detail.hasCat"
                }
              }
            ]
          },
          "actions": [
            {
              "type": "button",
              "label": "t:github.wsCommunity.openThread",
              "act": "thread",
              "args": {
                "id": "$.community.detail.thread"
              },
              "when": "$.community.detail.thread"
            },
            {
              "type": "button",
              "label": "t:github.work.openGithub",
              "act": "openUrl",
              "args": {
                "url": "$.community.detail.url"
              }
            }
          ]
        },
        {
          "type": "section",
          "when": "$.community.detail.dir",
          "title": "t:github.wsCommunity.directionCard",
          "help": "t:github.wsCommunity.directionHelp",
          "blocks": [
            {
              "type": "settings",
              "from": "$.community.detail.dir.questions",
              "row": {
                "label": "@label",
                "control": {
                  "type": "text",
                  "text": "@value"
                }
              },
              "rows": [
                {
                  "label": "t:github.wsCommunity.evidence",
                  "control": {
                    "type": "text",
                    "parts": [
                      {
                        "parts": "$.community.detail.dir.evidence",
                        "sep": "、",
                        "each": {
                          "text": "@"
                        }
                      }
                    ]
                  }
                },
                {
                  "label": "t:github.wsCommunity.detail.recommendedRoute",
                  "control": {
                    "type": "text",
                    "text": {
                      "of": "$.community.detail.dir.route",
                      "map": {
                        "decline": {
                          "t": "github.common.reject",
                          "args": [
                            "$.community.detail.threadTitle"
                          ]
                        },
                        "new": {
                          "t": "github.workbench.route.new",
                          "args": [
                            "$.community.detail.threadTitle"
                          ]
                        },
                        "existing": {
                          "t": "github.workbench.route.thread",
                          "args": [
                            "$.community.detail.threadTitle"
                          ]
                        },
                        "continue": {
                          "t": "github.workbench.route.thread",
                          "args": [
                            "$.community.detail.threadTitle"
                          ]
                        },
                        "thread": {
                          "t": "github.workbench.route.thread",
                          "args": [
                            "$.community.detail.threadTitle"
                          ]
                        },
                        "_": "$.community.detail.dir.route"
                      }
                    }
                  }
                },
                {
                  "label": "t:github.wsCommunity.detail.role",
                  "control": {
                    "type": "text",
                    "text": "$.community.detail.dir.role"
                  }
                }
              ]
            },
            {
              "type": "toolbar",
              "items": [
                {
                  "type": "button",
                  "primary": "$.community.detail.dir.accept",
                  "label": "t:github.common.accept",
                  "act": "plugin",
                  "args": {
                    "request": "status",
                    "entity": "issue",
                    "id": "$.community.detail.n",
                    "v": "accepted"
                  },
                  "disabled": "$.pending"
                },
                {
                  "type": "button",
                  "primary": "$.community.detail.dir.reject",
                  "label": "t:github.common.reject",
                  "act": "plugin",
                  "args": {
                    "request": "status",
                    "entity": "issue",
                    "id": "$.community.detail.n",
                    "v": "rejected"
                  },
                  "disabled": "$.pending"
                }
              ]
            }
          ]
        },
        {
          "type": "section",
          "when": "$.community.detail.closure",
          "title": "t:github.wsCommunity.preCloseCheck",
          "blocks": [
            {
              "type": "list",
              "from": "$.community.detail.closure.rows",
              "row": "community.closure"
            },
            {
              "type": "toolbar",
              "items": [
                {
                  "type": "button",
                  "label": "t:github.wsCommunity.markReplied",
                  "act": "dialog",
                  "args": {
                    "kind": "github.report"
                  },
                  "when": "$.community.detail.closure.pending"
                },
                {
                  "type": "button",
                  "label": "t:github.wsCommunity.exemptClose",
                  "act": "dialog",
                  "args": {
                    "kind": "github.waive"
                  },
                  "when": "$.community.detail.closure.pending"
                },
                {
                  "type": "button",
                  "primary": true,
                  "label": "t:github.wsCommunity.closeIssue",
                  "act": "plugin",
                  "args": {
                    "request": "status",
                    "entity": "issue",
                    "id": "$.community.detail.n",
                    "v": "closed"
                  },
                  "disabled": "$.pending"
                }
              ]
            }
          ]
        },
        {
          "type": "toolbar",
          "when": "$.community.repos",
          "note": "1",
          "items": [
            {
              "type": "input",
              "id": "ws-repo",
              "mono": true,
              "list": "ws-repos",
              "listFrom": "$.community.repos",
              "value": "$.community.list.repo",
              "placeholder": "owner/repo",
              "label": "t:github.chatCards.field.repo",
              "go": "plugin",
              "icon": "refresh",
              "goLabel": "t:github.wsCommunity.sync",
              "args": {
                "request": "sync"
              },
              "disabled": "$.pending"
            }
          ]
        },
        {
          "type": "empty",
          "when": "$.community.noRepo",
          "text": "t:github.wsCommunity.syncHelp"
        },
        {
          "type": "text",
          "variant": "meta",
          "when": "$.community.list",
          "text": {
            "t": "github.workbench.communitySummary",
            "args": [
              "$.community.list.syncing",
              "$.community.list.issueCount",
              "$.community.list.prCount"
            ]
          }
        },
        {
          "type": "toolbar",
          "when": "$.community.list",
          "items": [
            {
              "type": "select",
              "id": "ws-c-st",
              "options": [
                {
                  "v": "all",
                  "label": "t:github.wsCommunity.allStates"
                },
                {
                  "v": "unreplied",
                  "label": "t:github.wsCommunity.unreplied"
                },
                {
                  "v": "discussing",
                  "label": "t:github.wsCommunity.discussing"
                },
                {
                  "v": "pending_decision",
                  "label": "t:github.wsCommunity.pendingDecision"
                },
                {
                  "v": "accepted",
                  "label": "t:github.memoryOwners.stateNote.materialized"
                },
                {
                  "v": "rejected",
                  "label": "t:github.memoryOwners.stateNote.rejected"
                },
                {
                  "v": "closed",
                  "label": "t:github.wsCommunity.closed"
                }
              ],
              "value": "$.community.list.fs",
              "change": "plugSet",
              "label": "t:github.common.state",
              "args": {
                "k": "cSt"
              }
            },
            {
              "type": "select",
              "id": "ws-c-cat",
              "options": [
                {
                  "v": "all",
                  "label": "t:github.wsCommunity.list.cats"
                },
                {
                  "from": "$.community.list.cats",
                  "item": {
                    "v": "@v",
                    "label": {
                      "t": "github.workbench.identity",
                      "args": [
                        "@name",
                        "@handle"
                      ]
                    }
                  }
                }
              ],
              "value": "$.community.list.fc",
              "change": "plugSet",
              "label": "t:github.wsCommunity.ownerCat",
              "args": {
                "k": "cCat"
              }
            },
            {
              "type": "seg",
              "value": "$.community.list.ft",
              "act": "plugSet",
              "args": {
                "k": "cTime"
              },
              "options": [
                {
                  "v": "all",
                  "label": "t:github.memory.allTime"
                },
                {
                  "v": "7",
                  "label": "t:github.wsCommunity.within7d"
                },
                {
                  "v": "30",
                  "label": "t:github.wsCommunity.within30d"
                },
                {
                  "v": "90",
                  "label": "t:github.wsCommunity.within90d"
                }
              ]
            }
          ]
        },
        {
          "type": "section",
          "when": "$.community.list",
          "title": "Issue",
          "note": "3",
          "keep": true,
          "blocks": [
            {
              "type": "list",
              "groups": "$.community.list.issueGroups",
              "group": {
                "title": {
                  "of": "@state",
                  "map": {
                    "pending_decision": "t:github.wsCommunity.pendingDecision",
                    "unreplied": "t:github.wsCommunity.unreplied",
                    "discussing": "t:github.wsCommunity.discussing",
                    "accepted": "t:github.memoryOwners.stateNote.materialized",
                    "rejected": "t:github.memoryOwners.stateNote.rejected",
                    "closed": "t:github.wsCommunity.closed",
                    "_": "@state"
                  }
                }
              },
              "row": "community.issue",
              "empty": "t:github.wsCommunity.list.empty"
            }
          ]
        },
        {
          "type": "section",
          "when": "$.community.list",
          "title": "PR",
          "keep": true,
          "blocks": [
            {
              "type": "list",
              "groups": "$.community.list.prGroups",
              "group": {
                "title": {
                  "of": "@state",
                  "map": {
                    "unreplied": "t:github.workbench.prGroup.unreplied",
                    "replied": "t:github.workbench.prGroup.replied",
                    "new": "t:github.frame.newActivity",
                    "merged": "t:github.workbench.prGroup.merged",
                    "closed": "t:github.wsCommunity.closed",
                    "_": "@state"
                  }
                }
              },
              "row": "community.pr",
              "empty": "t:github.wsCommunity.list.empty"
            }
          ]
        },
        {
          "type": "section",
          "title": "t:github.wsCommunity.reconcileFindings",
          "blocks": [
            {
              "type": "list",
              "from": "$.community.list.findings",
              "row": "community.finding",
              "optional": true
            }
          ]
        }
      ],
      "panel": [
        "t:github.plugin.entries.community",
        "msg",
        "",
        "other",
        "t:github.plugin.panel.desc"
      ],
      "bridge": [
        "theme",
        "members.read",
        "thread.open",
        "task.dispatch"
      ],
      "sources": {
        "community": "community"
      },
      "drill": [
        {
          "when": "$.community.detail",
          "act": "plugSet",
          "args": {
            "k": "detail",
            "v": ""
          }
        }
      ]
    },
    "dlg.github.report": {
      "title": "t:github.wsCommunity.markReplied",
      "fields": [
        {
          "id": "dlg-in",
          "label": "t:github.wsCommunity.report.label",
          "mono": true,
          "placeholder": "https://github.com/owner/repo/issues/N#issuecomment-…",
          "req": true,
          "arg": "reportURL"
        }
      ],
      "ok": "t:github.wsCommunity.submit",
      "okAct": "plugin",
      "okArgs": {
        "request": "report"
      }
    },
    "dlg.github.waive": {
      "title": "t:github.wsCommunity.exemptClose",
      "fields": [
        {
          "id": "dlg-r",
          "label": "t:github.wsCommunity.reason",
          "placeholder": "t:github.wsCommunity.reason",
          "req": true,
          "arg": "reason"
        },
        {
          "id": "dlg-e",
          "label": "t:github.wsCommunity.evidence",
          "placeholder": "t:github.wsCommunity.waiver.evidencePlaceholder",
          "req": true,
          "arg": "evidence"
        }
      ],
      "ok": "t:github.wsCommunity.submit",
      "okAct": "plugin",
      "okArgs": {
        "request": "waive"
      }
    }
  },
  "rows": {
    "community.issue": {
      "layout": "two",
      "lead": [
        {
          "glyph": "info"
        }
      ],
      "title": [
        {
          "parts": [
            {
              "parts": [
                "#",
                "@n"
              ],
              "sep": "",
              "tone": "muted"
            }
          ],
          "mono": true
        },
        {
          "text": "@title"
        }
      ],
      "sub": {
        "parts": [
          {
            "parts": [
              {
                "of": "@hasCat",
                "map": {
                  "true": {
                    "parts": [
                      "@catName",
                      " → ",
                      "@threadTitle"
                    ],
                    "sep": ""
                  },
                  "false": "—",
                  "_": "@hasCat"
                }
              }
            ]
          },
          {
            "text": " · "
          },
          {
            "text": {
              "of": "@ago",
              "fmt": "ago"
            }
          }
        ],
        "sep": ""
      },
      "cols": [
        {
          "w": "auto",
          "v": {
            "parts": [
              {
                "control": {
                  "type": "button",
                  "label": "t:github.wsCommunity.issue.menu.label",
                  "act": "plugin",
                  "args": {
                    "request": "route",
                    "n": "@n"
                  },
                  "when": "@unreplied",
                  "disabled": "$.pending"
                }
              },
              {
                "control": {
                  "type": "status",
                  "text": {
                    "t": "github.wsCommunity.priority",
                    "args": [
                      "@priority"
                    ]
                  },
                  "tone": {
                    "of": "@priority",
                    "map": {
                      "urgent": "danger",
                      "high": "warn",
                      "normal": "",
                      "_": "@priority"
                    }
                  },
                  "when": [
                    "!@unreplied",
                    "@drill",
                    "!@normalPriority"
                  ]
                }
              }
            ],
            "sep": ""
          }
        },
        {
          "control": []
        }
      ],
      "act": {
        "of": "@canOpen",
        "map": {
          "true": {
            "of": "@drill",
            "map": {
              "true": "plugSet",
              "false": "thread"
            }
          },
          "false": ""
        }
      },
      "args": {
        "k": "detail",
        "v": "@n",
        "id": "@thread",
        "plugin": "official.github-operations"
      },
      "tone": {
        "of": "@canOpen",
        "map": {
          "true": "",
          "false": "past",
          "_": "@canOpen"
        }
      }
    },
    "community.pr": {
      "layout": "two",
      "title": [
        {
          "parts": [
            {
              "parts": [
                "#",
                "@n"
              ],
              "sep": "",
              "tone": "muted"
            }
          ],
          "mono": true
        },
        {
          "text": "@title"
        }
      ],
      "sub": {
        "parts": [
          "@author",
          "@catName",
          {
            "of": "@ago",
            "fmt": "ago"
          }
        ],
        "sep": " · "
      },
      "meta": {
        "parts": [
          {
            "text": "@life"
          },
          {
            "text": "@cloud",
            "tone": {
              "of": "@cloudFail",
              "map": {
                "true": "danger",
                "false": "",
                "_": "@cloudFail"
              }
            }
          },
          {
            "text": {
              "t": "github.workbench.prCI",
              "args": [
                "@ci"
              ]
            },
            "tone": {
              "of": "@ciFail",
              "map": {
                "true": "danger",
                "false": "",
                "_": "@ciFail"
              }
            },
            "when": "@ci"
          },
          {
            "parts": [
              {
                "text": "t:github.wsCommunity.delivery.text",
                "when": "@sent"
              },
              {
                "text": "@sent",
                "mono": true,
                "when": "@sent"
              }
            ],
            "sep": "",
            "when": "@sent"
          }
        ],
        "sep": " · "
      },
      "act": "thread",
      "args": {
        "id": "@thread"
      },
      "cols": [
        {
          "v": [],
          "w": "auto"
        },
        {
          "control": []
        }
      ]
    },
    "community.finding": {
      "layout": "two",
      "title": "@msg",
      "sub": {
        "text": {
          "t": "github.wsCommunity.list.sub",
          "args": [
            "@kind",
            "@sev",
            {
              "of": "@st",
              "map": {
                "pending": "t:github.films.opinionState.open",
                "confirmed": "t:github.memoryOwners.stateNote.replayed",
                "resolved": "t:github.wsCommunity.resolved",
                "exempted": "t:github.wsCommunity.exempted",
                "_": "@st"
              }
            }
          ]
        }
      },
      "cols": [
        {
          "w": "auto",
          "control": [
            {
              "type": "button",
              "label": "t:github.common.confirm",
              "act": "plugin",
              "args": {
                "request": "status",
                "entity": "finding",
                "id": "@i",
                "v": "confirmed"
              },
              "when": "@pending",
              "disabled": "$.pending"
            },
            {
              "type": "button",
              "label": "t:github.wsCommunity.resolved",
              "act": "plugin",
              "args": {
                "request": "status",
                "entity": "finding",
                "id": "@i",
                "v": "resolved"
              },
              "when": "@pending",
              "disabled": "$.pending"
            },
            {
              "type": "button",
              "label": "t:github.wsCommunity.exempt",
              "act": "plugin",
              "args": {
                "request": "status",
                "entity": "finding",
                "id": "@i",
                "v": "exempted"
              },
              "when": "@pending",
              "disabled": "$.pending"
            }
          ]
        },
        {
          "control": []
        }
      ]
    },
    "community.closure": {
      "layout": "two",
      "title": [
        {
          "text": "t:github.wsCommunity.exempted",
          "when": "@waived"
        },
        {
          "text": "@text",
          "when": "@blocker"
        },
        {
          "text": "t:github.wsCommunity.detail.checksPassed",
          "when": "@ready"
        }
      ],
      "sub": [
        {
          "text": "@text",
          "when": "@waived"
        }
      ],
      "cols": [
        {
          "w": "auto",
          "control": [
            {
              "type": "status",
              "tone": "warn",
              "text": "t:github.wsCommunity.detail.text",
              "when": "@blocker"
            },
            {
              "type": "status",
              "text": "t:github.wsCommunity.detail.ready",
              "when": "@ready"
            }
          ]
        },
        {
          "control": []
        }
      ]
    }
  },
  "requests": {
    "draft": {
      "path": "github/community-console/draft/read",
      "method": "POST",
      "body": {
        "mid": "@mid",
        "block": "@block",
        "title": "@title"
      }
    },
    "edit": {
      "path": "github/community-console/draft/edit",
      "method": "POST",
      "body": {
        "mid": "@mid",
        "b": "@b",
        "field": "@field",
        "value": "@v"
      }
    },
    "create": {
      "path": "github/community-console/draft/create",
      "method": "POST",
      "body": {
        "mid": "@mid",
        "b": "@b"
      }
    },
    "publish": {
      "path": "github/community-console/draft/publish",
      "method": "POST",
      "body": {
        "mid": "@mid",
        "b": "@b"
      }
    },
    "cancel": {
      "path": "github/community-console/draft/cancel",
      "method": "POST",
      "body": {
        "mid": "@mid",
        "b": "@b"
      }
    },
    "retry": {
      "path": "github/community-console/draft/retry",
      "method": "POST",
      "body": {
        "mid": "@mid",
        "b": "@b"
      }
    },
    "community": {
      "path": "github/community-console",
      "query": {
        "detail": "state.detail",
        "repo": "state.repo",
        "cSt": "state.cSt",
        "cCat": "state.cCat",
        "cTime": "state.cTime"
      }
    },
    "status": {
      "path": "github/community-console/status",
