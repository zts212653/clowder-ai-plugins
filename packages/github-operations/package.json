{
  "name": "@clowder-ai/github-operations",
  "version": "0.1.0-alpha.30",
  "description": "GitHub collaboration schedules and event operations for Clowder AI hosts",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": "./plugin.yaml"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "plugin.yaml",
    "README.md",
    "README.en.md",
    "assets",
    "skills",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test src/**/*.test.ts test/*.test.js",
    "lint": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "yaml": "2.9.0"
  },
  "keywords": [
    "clowder-ai",
    "github",
    "schedule",
    "events",
    "collaboration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zts212653/clowder-ai-plugins.git",
    "directory": "packages/github-operations"
  },
  "dependencies": {
    "@clowder-ai/plugin-contract": "0.3.2-candidate.0",
    "@clowder-ai/plugin-sdk": "0.3.0-beta.2-candidate.1",
    "zod": "3.25.76",
    "@modelcontextprotocol/sdk": "1.26.0",
    "fastify": "4.29.1"
  }
}
