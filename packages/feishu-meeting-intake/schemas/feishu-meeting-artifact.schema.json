{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clowder-ai.dev/plugins/feishu-meeting-intake/schemas/meeting-artifact/v1",
  "title": "Feishu generated meeting artifact metadata",
  "type": "object",
  "properties": {
    "artifactId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "artifactKind": { "type": "string", "enum": ["note", "minute"] },
    "revision": { "type": "string", "minLength": 1, "maxLength": 64 },
    "title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "meetingId": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "required": ["artifactId", "artifactKind", "revision"],
  "additionalProperties": false
}
