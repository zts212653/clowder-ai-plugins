{
  "name": "@clowder-ai/feishu-meeting-intake",
  "version": "0.1.0-alpha.0",
  "description": "Official Feishu/Lark generated-meeting-artifact intake adapter for Clowder AI hosts",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": "./manifest.json",
    "./schemas/meeting-artifact": "./schemas/feishu-meeting-artifact.schema.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "manifest.json",
    "schemas"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "test": "pnpm --filter @clowder-ai/plugin-contract build && pnpm --filter @clowder-ai/plugin-sdk build && node --import tsx --test src/**/*.test.ts",
    "lint": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clowder-ai/plugin-contract": "workspace:*",
    "@clowder-ai/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "clowder-ai",
    "feishu",
    "lark",
    "meeting",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zts212653/clowder-ai-plugins.git",
    "directory": "packages/feishu-meeting-intake"
  }
}
