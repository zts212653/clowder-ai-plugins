{
  "name": "@clowder-ai/plugin-memory-contract",
  "version": "0.1.0-candidate.9",
  "private": true,
  "description": "Clowder AI memory v1 wire DTOs, validation and explanation. Independent of plugin-contract and the plugin SDK.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./matter": {
      "types": "./dist/matter.d.ts",
      "import": "./dist/matter.js"
    },
    "./event": {
      "types": "./dist/event.d.ts",
      "import": "./dist/event.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.js"
    },
    "./taste": {
      "types": "./dist/taste.d.ts",
      "import": "./dist/taste.js"
    },
    "./entity": {
      "types": "./dist/entity.d.ts",
      "import": "./dist/entity.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "clean": "node ../../scripts/clean-path.mjs dist"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "clowder-ai",
    "memory",
    "contract",
    "wire"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zts212653/clowder-ai-plugins.git",
    "directory": "packages/plugin-memory-contract"
  }
}
