{
  "name": "@clowder-ai/superagent",
  "version": "0.1.0-alpha.1",
  "description": "Resident personal-conversation coordination for Clowder AI",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./manifest": "./manifest.json"
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md",
    "assets"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clowder-ai/plugin-contract": "0.3.3-candidate.0",
    "@clowder-ai/plugin-sdk": "0.3.0-beta.2-candidate.10",
    "zod": "4.6.7"
  },
  "bundledDependencies": [
    "@clowder-ai/plugin-sdk",
    "@clowder-ai/plugin-contract",
    "zod"
  ],
  "devDependencies": {
    "@types/node": "20.17.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "bundleDependencies": [
    "@clowder-ai/plugin-sdk",
    "@clowder-ai/plugin-contract",
    "zod"
  ]
}
