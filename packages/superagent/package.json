{
  "name": "@clowder-ai/superagent",
  "version": "0.1.0-alpha.3",
  "description": "Resident personal-conversation coordination for Clowder AI",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./manifest": "./plugin.yaml"
  },
  "files": [
    "dist",
    "plugin.yaml",
    "README.md",
    "README.en.md",
    "npm-shrinkwrap.json",
    "assets",
    "console"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clowder-ai/plugin-contract": "0.3.3-candidate.1",
    "@clowder-ai/plugin-sdk": "0.3.0-beta.2-candidate.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.17.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
