{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@clowder-ai/plugin-sdk": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.test.ts"],
  "exclude": ["node_modules", "dist"]
}
