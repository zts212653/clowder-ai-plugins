{
  "name": "@clowder-ai/plugin-sdk",
  "version": "0.1.0-beta.8",
  "description": "Schema-neutral standalone runtime primitives for Clowder AI plugins",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "test": "pnpm --filter @clowder-ai/plugin-contract build && pnpm build && node --import tsx --test src/stdio-runtime.test.ts src/wire-dispatch.test.ts src/contract-mirror.test.ts src/standalone-host.test.ts src/handshake-client.test.ts src/events-publisher.test.ts",
    "lint": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "prepack": "pnpm build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clowder-ai/plugin-contract": "0.1.0-beta.12"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "clowder-ai",
    "plugin",
    "sdk",
    "stdio"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zts212653/clowder-ai-plugins.git",
    "directory": "packages/plugin-sdk"
  }
}
