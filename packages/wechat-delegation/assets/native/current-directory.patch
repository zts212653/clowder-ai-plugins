+//! Group discovery is independent of the friend catalog. Cached group IDs are
+//! hints only; a new membership response must positively establish membership.
+use super::*;
+use std::collections::BTreeMap;
+
+fn contact_membership(record: &ContactRecord) -> Result<Option<bool>> {
+    Ok(match contact_patch(record)?.fields.get("is_in_chat_room") {
+        Some(SqlValue::Integer(value)) if value == "1" => Some(true),
+        Some(SqlValue::Integer(value)) if value == "2" => Some(false),
+        _ => None,
+    })
+}
+fn roster_membership(roster: &RoomRoster, room: &str, own: &str) -> Result<Option<bool>> {
+    ensure!(roster.room_id == room, "directory_foreign_roster");
+    if roster.members.iter().any(|member| member.username == own) {
+        return Ok(Some(true));
+    }
+    Ok(roster
+        .full_member_ids
+        .as_ref()
+        .map(|ids| ids.iter().any(|id| id == own)))
+}
+
+impl Core {
+    pub(super) fn current_group_rows(
+        &self,
+        account: &str,
+        operation: &str,
+        owner: &str,
+        deadline: Instant,
+    ) -> Result<(Vec<Value>, usize, bool)> {
+        let group_deadline = deadline.min(Instant::now() + Duration::from_secs(45));
+        let mut hints = BTreeMap::new();
+        let mut cursor = None;
+        let mut seen = HashSet::new();
+        loop {
+            self.metadata_check(account, operation, deadline)?;
+            let page = self.groups(
+                account,
+                &wechat_profile::ListQuery {
+                    limit: Some(200),
+                    cursor,
+                    search: None,
+                },
+            )?;
+            for row in page["items"]
+                .as_array()
+                .context("group_directory_cache_invalid")?
+            {
+                if let Some(id) = row["id"].as_str().filter(|id| id.ends_with("@chatroom")) {
+                    hints.insert(id.to_owned(), row.clone());
+                }
+            }
+            cursor = page["nextCursor"].as_str().map(str::to_owned);
+            match &cursor {
+                None => break,
+                Some(value) => {
+                    ensure!(seen.insert(value.clone()), "group_directory_cursor_stalled");
+                }
+            }
+        }
+        let mut discovery_incomplete = false;
+        let mut group_cursor = vec![0];
+        let mut cursors = HashSet::new();
+        let mut catalog_done = false;
+        for _ in 0..50 {
+            self.metadata_check(account, operation, deadline)?;
+            if Instant::now() >= group_deadline {
+                break;
+            }
+            let mut state = self.account_state(account)?;
+            let response = self.native_request(account, &mut state, |request| {
+                request.group_inventory(&group_cursor)
+            });
+            // This service is explicitly partial upstream. Failure to discover
+            // more IDs does not invalidate separately reverified known groups.
+            let page = match response {
+                Ok(page) => page,
+                Err(_) => {
+                    discovery_incomplete = true;
+                    break;
+                }
+            };
+            self.save_state(account, &state)?;
+            for record in &page.contacts {
+                if record.username.ends_with("@chatroom") {
+                    let label = record
+                        .remark
+                        .as_ref()
+                        .or(record.nickname.as_ref())
+                        .unwrap_or(&record.username);
+                    hints
+                        .entry(record.username.clone())
+                        .or_insert_with(|| json!({"id":record.username,"displayName":label}));
+                }
+            }
+            ensure!(hints.len() <= 10000, "group_directory_capacity_exceeded");
+            let more = page.more;
+            let wait = page.wait_seconds;
+            let next = page.next_cursor.clone();
+            let receipt = self.stage_metadata_body(account, ReceiptBody::GroupCatalog(page))?;
+            self.apply_metadata_receipt(account, &receipt, false)?;
+            if !more {
+                catalog_done = true;
+                break;
+            }
+            group_cursor = next.context("group_directory_cursor_missing")?;
+            ensure!(
+                cursors.insert(group_cursor.clone()),
+                "group_directory_cursor_stalled"
+            );
+            if wait > 10 {
+                break;
+            }
+            for _ in 0..wait * 10 {
+                self.metadata_check(account, operation, deadline)?;
+                if Instant::now() >= group_deadline {
+                    break;
+                }
+                std::thread::sleep(Duration::from_millis(100));
+            }
+        }
+        discovery_incomplete |= !catalog_done;
+        let ids: Vec<_> = hints.keys().cloned().collect();
+        let mut rows = Vec::new();
+        let mut unverified = 0;
+        let mut processed = 0;
+        for batch in ids.chunks(2) {
+            self.metadata_check(account, operation, deadline)?;
+            if Instant::now() >= group_deadline {
+                unverified += ids.len() - processed;
+                discovery_incomplete = true;
+                break;
+            }
+            processed += batch.len();
+            let reply = match self.metadata_contact_reply(account, batch) {
+                Ok(reply) => reply,
+                Err(_) => {
+                    unverified += batch.len();
+                    continue;
+                }
+            };
+            for (index, id) in batch.iter().enumerate() {
+                let record = reply
+                    .value
+                    .contacts
+                    .iter()
+                    .find(|record| &record.username == id);
+                if (!reply.value.results.is_empty() && reply.value.results.get(index) != Some(&0))
+                    || record.is_none()
+                {
+                    unverified += 1;
+                    continue;
+                }
+                let record = record.unwrap();
+                let member = match contact_membership(record)? {
+                    Some(value) => value,
+                    None => {
+                        // Sparse contact details are not negative membership.
+                        // A fresh roster containing this exact owner is positive proof.
+                        let mut state = self.account_state(account)?;
+                        let result = self
+                            .account_upstream(account)?
+                            .lookup_room_receipt(&mut state, id, 0);
+                        match result {
+                            Ok(reply) => {
+                                self.save_state(account, &state)?;
+                                match roster_membership(&reply.value, id, owner)? {
+                                    Some(value) => value,
+                                    None => {
+                                        unverified += 1;
+                                        continue;
+                                    }
+                                }
+                            }
+                            Err(_) => {
+                                unverified += 1;
+                                continue;
+                            }
+                        }
+                    }
+                };
+                if member {
+                    let mut row = hints[id].clone();
+                    if let Some(label) = record
+                        .remark
+                        .as_ref()
+                        .or(record.nickname.as_ref())
+                        .filter(|value| !value.is_empty())
+                    {
+                        row["displayName"] = json!(label);
+                    }
+                    row["nickname"] = json!(record.nickname);
+                    row["remark"] = json!(record.remark);
+                    row["alias"] = json!(record.alias);
+                    row["currentMember"] = json!(true);
+                    rows.push(row);
+                }
+            }
+            let receipt = self.stage_metadata_body(
+                account,
+                ReceiptBody::Contacts {
+                    requested: batch.to_vec(),
+                    reply,
+                },
+            )?;
+            self.apply_metadata_receipt(account, &receipt, false)?;
+        }
+        Ok((rows, unverified, discovery_incomplete))
+    }
+}
