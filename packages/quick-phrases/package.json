{
  "name": "@clowder-ai/quick-phrases",
  "version": "0.1.0-alpha.3",
  "description": "Save and reuse common instructions in the Clowder AI chat composer",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
