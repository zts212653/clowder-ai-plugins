{
  "name": "@clowder-ai/xiangqi",
  "version": "0.1.0-alpha.1",
  "description": "Xiangqi analysis and board assets for a Host-bound companion game",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./manifest": "./plugin.yaml",
    "./board": "./dist/board-server.mjs"
  },
  "bin": {
    "clowder-xiangqi-mcp": "./dist/mcp-entrypoint.mjs"
  },
  "files": [
    "dist",
    "plugin.yaml",
    "README.md",
    "assets",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node ../../scripts/package-bins.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/browser.journey.mjs",
    "lint": "node --test test/manifest.test.mjs test/privacy.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@clowder-ai/plugin-contract": "0.1.0-beta.19",
    "playwright": "1.61.1",
    "yaml": "^2.8.1"
  },
  "keywords": [
    "clowder-ai",
    "plugin",
    "xiangqi",
    "chinese-chess"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zts212653/clowder-ai-plugins.git",
    "directory": "packages/xiangqi"
  }
}
