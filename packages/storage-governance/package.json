{
  "name": "@clowder-ai/storage-governance",
  "version": "0.1.0-alpha.1",
  "description": "Read-only storage inventory for conversations, works, worktrees, caches and host data",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": "./plugin.yaml"
  },
  "files": [
    "dist",
    "plugin.yaml",
    "assets",
    "console",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --import tsx --test test/*.test.ts",
    "preview": "node scripts/preview.mjs",
    "check:ui": "node scripts/build-ui.mjs && node scripts/preview.mjs && node scripts/interaction-check.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zts212653/clowder-ai-plugins.git",
    "directory": "packages/storage-governance"
  }
}
