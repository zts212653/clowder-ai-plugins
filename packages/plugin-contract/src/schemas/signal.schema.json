{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clowder-ai.dev/schemas/signals/v0.2",
  "title": "Clowder AI Signal Declarations",
  "description": "Manifest-only signal declarations and contribution metadata. Runtime publication is not part of this schema.",
  "x-clowder-forbidden-privacy-classes": [
    "av-raw",
    "input-raw"
  ],
  "x-clowder-forbidden-source-classes": [
    "av-capture",
    "input-hardware"
  ],
  "$defs": {
    "SignalType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "SignalSchemaRef": {
      "type": "string",
      "description": "Package-local content schema reference declared in manifest metadata.",
      "minLength": 21,
      "maxLength": 256,
      "pattern": "^schemas/([A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.schema\\.json$"
    },
    "SignalEpistemicStatus": {
      "type": "string",
      "enum": [
        "observation",
        "inference"
      ]
    },
    "SignalPrivacyClass": {
      "type": "string",
      "enum": [
        "behavioral",
        "content-adjacent",
        "content",
        "av-raw",
        "input-raw"
      ]
    },
    "AdmissibleSignalPrivacyClass": {
      "type": "string",
      "enum": [
        "behavioral",
        "content-adjacent",
        "content"
      ]
    },
    "SignalSourceClass": {
      "type": "string",
      "enum": [
        "os-metadata",
        "accessibility-api",
        "remote-service",
        "av-capture",
        "input-hardware"
      ]
    },
    "AdmissibleSignalSourceClass": {
      "type": "string",
      "enum": [
        "os-metadata",
        "accessibility-api",
        "remote-service"
      ]
    },
    "SignalDeclaration": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/SignalType"
        },
        "schemaRef": {
          "$ref": "#/$defs/SignalSchemaRef"
        },
        "epistemicStatus": {
          "$ref": "#/$defs/SignalEpistemicStatus"
        },
        "privacyClass": {
          "$ref": "#/$defs/AdmissibleSignalPrivacyClass"
        },
        "sourceClass": {
          "$ref": "#/$defs/AdmissibleSignalSourceClass"
        }
      },
      "required": [
        "type",
        "schemaRef",
        "epistemicStatus",
        "privacyClass",
        "sourceClass"
      ],
      "additionalProperties": false
    },
    "SignalContribution": {
      "type": "object",
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SignalDeclaration"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "provides"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/SignalContribution"
}
