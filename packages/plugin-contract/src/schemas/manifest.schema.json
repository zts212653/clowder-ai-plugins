{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clowder-ai.dev/schemas/manifest/v0.1",
  "title": "Clowder AI Plugin Manifest (v0.1)",
  "description": "Machine-readable truth source for plugin manifest (§3.4/§3.5). v0.1 covers core manifest + features + data classification. Signals/events (C-2) and schedule/state (C-3) are schema deltas in future contract versions.",

  "$defs": {
    "DataClass": {
      "type": "string",
      "enum": ["cache", "ephemeral", "user-authored", "derived-user-visible", "relationship", "interaction-history"]
    },

    "DataStrategy": {
      "type": "string",
      "enum": ["lifecycle", "retained", "ask-on-uninstall"]
    },

    "DataDeclaration": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dataClass": { "$ref": "#/$defs/DataClass" },
        "strategy": { "$ref": "#/$defs/DataStrategy" },
        "schemaVersion": { "type": "string" }
      },
      "required": ["name", "dataClass", "strategy"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "dataClass": {
                "enum": ["user-authored", "derived-user-visible", "relationship", "interaction-history"]
              }
            },
            "required": ["dataClass"]
          },
          "then": {
            "properties": {
              "strategy": {
                "enum": ["retained", "ask-on-uninstall"],
                "description": "User-visible/relationship data MUST be retained or ask-on-uninstall. lifecycle is structurally forbidden (铁律 #5: user state defaults to persistent)."
              }
            }
          }
        }
      ]
    },

    "ResourceReference": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "id"],
      "additionalProperties": false
    },

    "PluginFeature": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/ResourceReference" }
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["id", "name", "resources", "capabilities"],
      "additionalProperties": false
    },

    "RuntimeTransport": {
      "type": "string",
      "enum": ["stdio", "ipc", "builtin"]
    },

    "RuntimeDeclaration": {
      "type": "object",
      "properties": {
        "transport": { "$ref": "#/$defs/RuntimeTransport" },
        "entrypoint": { "type": "string" }
      },
      "required": ["transport"],
      "additionalProperties": false
    }
  },

  "type": "object",
  "properties": {
    "pluginId": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "description": "Plugin version — must be valid semver."
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "description": "Must be an exact published semver version — no ranges, wildcards, or operator prefixes (five-step freeze: pin exact version)."
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/PluginFeature" },
      "minItems": 1
    },
    "data": {
      "type": "array",
      "items": { "$ref": "#/$defs/DataDeclaration" }
    },
    "runtime": { "$ref": "#/$defs/RuntimeDeclaration" }
  },
  "required": ["pluginId", "version", "contractVersion", "name", "features", "runtime"],
  "additionalProperties": false
}
