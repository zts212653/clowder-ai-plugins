{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clowder-ai.dev/schemas/behavior-fixture/v0.1",
  "title": "Clowder AI Contract Behavior Fixture",
  "type": "object",
  "properties": {
    "_meta": { "$ref": "#/$defs/FixtureMetadata" },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/BehaviorCase" },
      "minItems": 1
    }
  },
  "required": ["_meta", "cases"],
  "additionalProperties": false,
  "$defs": {
    "FixtureMetadata": {
      "type": "object",
      "properties": {
        "executor": { "const": "loopback" },
        "domain": { "const": "messaging" },
        "contractVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
        },
        "source": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "required": ["executor", "domain", "contractVersion", "source", "description"],
      "additionalProperties": false
    },
    "FixtureCaller": {
      "type": "object",
      "properties": {
        "pluginInstanceId": { "type": "string", "minLength": 1 }
      },
      "required": ["pluginInstanceId"],
      "additionalProperties": false
    },
    "FixtureHandle": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["thread_handle", "connector_binding", "message_handle", "subscription"]
        },
        "token": { "type": "string", "minLength": 1 },
        "ownerPluginInstanceId": { "type": "string", "minLength": 1 },
        "threadId": { "type": "string", "minLength": 1 },
        "messageId": { "type": "string", "minLength": 1 },
        "connectorId": { "type": "string", "minLength": 1 },
        "subscriptionId": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "token", "ownerPluginInstanceId"],
      "additionalProperties": false
    },
    "FixtureSetup": {
      "type": "object",
      "properties": {
        "caller": { "$ref": "#/$defs/FixtureCaller" },
        "grants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "handles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/FixtureHandle" }
        },
        "state": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["caller", "grants", "handles", "state"],
      "additionalProperties": false
    },
    "FixtureOperation": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["send", "appendElements", "subscribe", "read", "ack", "snapshot"]
        },
        "input": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["operation", "input"],
      "additionalProperties": false
    },
    "MessagingErrorCode": {
      "type": "string",
      "enum": ["VALIDATION", "PERMISSION", "NOT_FOUND", "CONFLICT", "RETRYABLE_INFLIGHT", "STALE_CURSOR"]
    },
    "SideEffectAssertion": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "enum": ["messages", "output_events", "idempotency_ledger", "subscription", "snapshot", "reply_preview", "provenance"]
        },
        "assertion": {
          "type": "string",
          "enum": ["unchanged", "none", "state_equals", "round_trip", "matches"]
        },
        "value": true
      },
      "required": ["target", "assertion"],
      "additionalProperties": false
    },
    "ExpectedVerdict": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["success", "error"] },
        "errorCode": { "$ref": "#/$defs/MessagingErrorCode" },
        "sideEffects": {
          "type": "array",
          "items": { "$ref": "#/$defs/SideEffectAssertion" },
          "minItems": 1
        }
      },
      "required": ["status", "sideEffects"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "error" } },
            "required": ["status"]
          },
          "then": { "required": ["errorCode"] }
        }
      ]
    },
    "BehaviorCase": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "invariant": { "type": "string", "minLength": 1 },
        "given": { "$ref": "#/$defs/FixtureSetup" },
        "when": { "$ref": "#/$defs/FixtureOperation" },
        "expect": { "$ref": "#/$defs/ExpectedVerdict" }
      },
      "required": ["id", "invariant", "given", "when", "expect"],
      "additionalProperties": false
    }
  }
}
