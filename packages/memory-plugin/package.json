{
  "name": "@clowder-ai/memory-plugin",
  "version": "0.1.0-candidate.0",
  "private": true,
  "description": "Official Clowder AI memory plugin: thread KV, evidence retrieval and memory business ownership.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": "./plugin.yaml"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "plugin.yaml",
    "console",
    "README.md",
    "README.en.md",
    "assets"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "test": "pnpm --filter @clowder-ai/plugin-sdk build && pnpm --filter @clowder-ai/plugin-memory-contract build && pnpm build && node --import tsx --test \"test/**/*.test.ts\"",
    "lint": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "clean": "node ../../scripts/clean-path.mjs dist"
  },
  "dependencies": {
    "@clowder-ai/plugin-memory-contract": "workspace:*",
    "js-tiktoken": "1.0.21",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@clowder-ai/plugin-contract": "workspace:*",
    "@clowder-ai/plugin-sdk": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "yaml": "2.9.0"
  },
  "keywords": [
    "clowder-ai",
    "memory",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zts212653/clowder-ai-plugins.git",
    "directory": "packages/memory-plugin"
  }
}
