{
  "manifest_version": 3,
  "name": "Cat Café · Tripo",
  "version": "0.1.7",
  "description": "授权读取当前打开的 Tripo 模型页，供猫在后台比较与回流资产。",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "scripting", "activeTab"],
  "optional_host_permissions": ["https://studio.tripo3d.ai/*"],
  "background": {
    "service_worker": "extension/background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "Tripo 后台审模"
  }
}
