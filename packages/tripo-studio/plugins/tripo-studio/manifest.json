{
  "manifest_version": 3,
  "name": "Cat Café · Tripo",
  "version": "0.2.0",
  "description": "读取模型，或经单独授权使用网页订阅生成与取回正式导出。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://studio.tripo3d.ai/*"
  ],
  "background": {
    "service_worker": "extension/background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "Tripo 后台审模"
  },
  "optional_permissions": [
    "downloads"
  ]
}
