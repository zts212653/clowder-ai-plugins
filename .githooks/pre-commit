#!/bin/bash
# .githooks/pre-commit — mirror-main guard (clowder-ai-plugins).
#
# In a contributor clone, main mirrors the upstream (origin is the upstream
# repository) and is re-synced with `git fetch && git reset --hard origin/main`;
# a commit made on it is silently lost at the next sync. Feature work belongs
# on a feature branch + worktree.
#
# Rule: refuse a commit when the current branch is main and origin is exactly
# the upstream repository (compared as a host/owner/repo identity). Any other
# origin — a fork, a lookalike, a local path, none at all — is left alone.
# `git commit --no-verify` bypasses it: this guards against muscle memory, not
# malice.

HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=guard-lib.sh
if ! . "$HOOK_DIR/guard-lib.sh" 2>/dev/null; then
  echo "pre-commit: guard-lib.sh is missing next to this hook; re-run pnpm guards:install." >&2
  exit 1
fi

BRANCH=$(git branch --show-current 2>/dev/null)
[ "$BRANCH" = "main" ] || exit 0

ORIGIN_URL=$(git remote get-url origin 2>/dev/null || true)
ORIGIN=$(guard_repo_identity "$ORIGIN_URL" || true)
[ "$ORIGIN" = "$GUARD_UPSTREAM_IDENTITY" ] || exit 0

echo "pre-commit: refusing to commit on main: origin is the upstream (${GUARD_UPSTREAM_IDENTITY}) and main mirrors it." >&2
echo "  Feature work belongs on a feature branch + worktree." >&2
echo "  If you really mean it: git commit --no-verify" >&2
exit 1
